  "hosted_verification": {
    "status": "not_run",
    "note": "Hosted readback is performed by the operator's coordinator after deploy; this evidence claims local unit, typecheck, and Playwright browser layout verification only."
  },
  "root_cause": {
    "summary": "The shared Badge in src/components/ui/badge.tsx uses inline-flex without whitespace-nowrap, allowing CJK labels in StatusBadge and RiskBadge to wrap across lines when table columns or flex headers compress them (measuring 38px high on /management/approvals table rows and three lines in the drawer). In src/management/pages/Operations.tsx, the three SheetHeader id spans lacked min-w-0 and break-all inside flex items-center gap-2 rows, causing 68-character approval decision ids (such as apv-07db6c62179bfb41bcb790001c955022535fe863aa003a8458e1eea8d62c7574) to render 462px wide, overflow the 520px sheet right edge by 51px at both 1440 and 1280 viewports, and squeeze the drawer status badge."
  },
  "scope": {
    "delivered": [
      "Added whitespace-nowrap to every branch of StatusBadge (src/platform/components/StatusBadge.tsx) and RiskBadge (src/platform/components/RiskBadge.tsx), including unavailable fallbacks, while leaving src/components/ui/badge.tsx unchanged.",
      "Added min-w-0 and break-all to all three sheet header id spans in src/management/pages/Operations.tsx (AlertsPage, IncidentsPage, ApprovalsPage) without truncation or ellipsis so operators can copy the full id from the DOM.",
      "Added unit tests in src/platform/components/StatusBadge.test.tsx covering all StatusBadge and RiskBadge branches plus verifying the shared Badge remains free of whitespace-nowrap.",
      "Added unit tests in src/management/pages/Operations.test.tsx verifying the 68-character approval id wraps with min-w-0 and break-all in the approval drawer and all Operations sheet headers with no truncation.",
      "Added Playwright layout regression spec e2e/approvals-badge-layout.spec.ts with ignoreDefaultArgs: ['--hide-scrollbars'], route mocks for GET /bff/approvals and GET /api/v1/approval-decisions, and bounding-box assertions at 1440x900 and 1280x900."
    ],
    "not_changing": [
      "src/components/ui/badge.tsx is unchanged so badges carrying long text in other callers can still wrap.",
      "src/platform/components/DataTable.tsx and src/management/pages/ObjectListPage.tsx are unchanged (owned by FE-ARTIFACT-TABLE-OWNER-WIDTH-20261106).",
      "No locale changes and no backend changes."
    ]
  },
